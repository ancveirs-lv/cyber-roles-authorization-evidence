{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ancveirs-lv/cyber-roles-authorization-evidence/main/schemas/terms.schema.json",
  "title": "Cyber terminology dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "terms"],
  "properties": {
    "schema_version": {"const": 2},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/term"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "label_en", "label_lv", "domain", "status",
        "definition_en", "definition_lv", "authorization_note_en",
        "authorization_note_lv", "not_synonymous_with", "source_ids",
        "last_reviewed"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label_en": {"$ref": "#/$defs/nonEmptyString"},
        "label_lv": {"$ref": "#/$defs/nonEmptyString"},
        "domain": {
          "enum": [
            "actor_identity", "professional_role", "team_function",
            "organisational_function", "authorization",
            "vulnerability_process", "community_jargon", "communication_role"
          ]
        },
        "status": {
          "enum": [
            "established", "established_with_context",
            "historical_or_community_jargon", "common_but_contested",
            "project_descriptive_category", "avoid_as_canonical"
          ]
        },
        "definition_en": {"$ref": "#/$defs/nonEmptyString"},
        "definition_lv": {"$ref": "#/$defs/nonEmptyString"},
        "authorization_note_en": {"$ref": "#/$defs/nonEmptyString"},
        "authorization_note_lv": {"$ref": "#/$defs/nonEmptyString"},
        "not_synonymous_with": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "uniqueItems": true
        },
        "last_reviewed": {"type": "string", "format": "date"}
      }
    }
  }
}
